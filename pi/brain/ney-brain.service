[Unit]
Description=Ney brain (Pi): light schedule failover when the Mac is asleep
After=network-online.target
Wants=network-online.target

[Service]
User=mjney99
WorkingDirectory=/home/mjney99/NeyBrain
ExecStart=/usr/bin/python3 -u /home/mjney99/NeyBrain/ney_brain.py
Restart=always
RestartSec=10
StandardOutput=append:/home/mjney99/NeyBrain/brain.log
StandardError=append:/home/mjney99/NeyBrain/brain.log

[Install]
WantedBy=multi-user.target
